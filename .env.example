# —— 数据库（必填其一）——
# Supabase：打开 Dashboard → Project Settings → Database → Connection string
# - 选「URI」，模式选「Transaction pooler」时，端口多为 6543。
# - 用户名必须是：postgres.<项目 ref>（ref 即项目 URL 里 xxx.supabase.co 的 xxx），不能用纯 postgres，也不能留 xxxxx 占位符。
# - 密码填「Database password」；若含 @ # 等特殊字符，需做 URL 编码后再写入连接串。
# 示例（请整行替换为你的真实 ref 与密码）：
# DATABASE_URL="postgresql+psycopg://postgres.abcdefghijklmnop:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# 若仍报 Tenant or user not found：对照控制台重新复制 URI，或改用控制台提供的 Session pooler / Direct connection 字符串（注意端口与用户名格式说明）。
# 本地快速跑通（无需 Supabase）：
# DATABASE_URL="sqlite:///./storage/mybroker.db"
DATABASE_URL="postgresql+psycopg://postgres.你的项目ref:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
AUTO_CREATE_TABLES="false"
BAILIAN_API_KEY=""
BAILIAN_BASE_URL="https://coding.dashscope.aliyuncs.com/v1"
BAILIAN_VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_VISION_API_KEY=""
BAILIAN_MODEL="qwen-plus"
BAILIAN_VISION_MODEL="qwen-vl-max-latest"
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://coding.dashscope.aliyuncs.com/v1"
DASHSCOPE_VISION_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_VISION_API_KEY=""
DASHSCOPE_MODEL="qwen-plus"
DASHSCOPE_VISION_MODEL="qwen-vl-max-latest"
AGENT_BACKEND_URL=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="mybroker-screenshots"
REMINDER_PUSH_ENABLED="false"
WEBHOOK_WECOM_URL=""
WEBHOOK_FEISHU_URL=""
WEBHOOK_DINGTALK_URL=""
AUTO_PUSH_DAILY_ENABLED="false"
AUTO_PUSH_DAILY_CHANNEL="wecom"
AUTO_PUSH_DAILY_HOUR="9"
AUTO_PUSH_DAILY_MINUTE="0"
AUTO_PUSH_WEEKDAYS_ONLY="true"
NOTIFY_RETRY_TIMES="2"
NOTIFY_TEMPLATE_HEADER=""
NOTIFY_TEMPLATE_FOOTER=""
NOTIFY_WEEKEND_TEMPLATE_HEADER=""
NOTIFY_WEEKEND_TEMPLATE_FOOTER=""
NOTIFY_FAILURE_TEMPLATE="主渠道发送失败，已尝试降级渠道。请检查 webhook 配置与网络连通性。"
NOTIFY_FALLBACK_CHANNELS="feishu,dingtalk"
NOTIFY_ALERT_ENABLED="false"
NOTIFY_ALERT_THRESHOLD="3"
NOTIFY_ALERT_CRITICAL_THRESHOLD="6"
NOTIFY_ALERT_CHANNEL="wecom"
NOTIFY_ALERT_COOLDOWN_MINUTES="60"
NOTIFY_SELF_HEAL_ENABLED="true"
NOTIFY_SELF_HEAL_PAUSE_MINUTES="30"
NOTIFY_SELF_HEAL_PROBE_ENABLED="true"
NOTIFY_SELF_HEAL_PROBE_INTERVAL_MINUTES="5"
NOTIFY_HEALTH_ALERT_ENABLED="false"
NOTIFY_CHANNEL_HEALTH_ALERT_ENABLED="false"
NOTIFY_HEALTH_WARNING_SCORE="80"
NOTIFY_HEALTH_CRITICAL_SCORE="60"
NOTIFY_HEALTH_CRITICAL_DAYS="3"
NOTIFY_ALERT_SUPPRESSED_CHANNELS=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
